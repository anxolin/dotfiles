[core]
  excludesFile = ~/dotfiles/git/gitignore_global

[user]
  name = Anxo Rodriguez
  email = 2352112+anxolin@users.noreply.github.com
	name = Anxo

[init]
  defaultBranch = main

[push]
  default = simple

[pull]
  rebase = true

[rebase]
  autosquash = true
  autostash = true

[fetch]
  prune = true

[rerere]
  enabled = true

[column]
  ui = auto

[branch]
  sort = -committerdate

[log]
  date = relative

[format]
  pretty = format:%C(yellow)%h %Cblue%>(12)%ad %Cgreen%<(7)%aN%Cred%d %Creset%s

[credential]
  helper = cache --timeout=86400

# Machine-local overrides (work email, GPG key, etc.) live here. Not tracked.
[include]
  path = ~/.gitconfiglocal

[merge]
  tool = vscode
[mergetool "vscode"]
  cmd = code --wait $MERGED

[diff]
  tool = vscode
  algorithm = histogram
  colorMoved = zebra
[difftool "vscode"]
  cmd = code --wait --diff $LOCAL $REMOTE

