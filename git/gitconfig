[core]
  excludesFile = ~/dotfiles/git/gitignore_global
	sshCommand = /usr/bin/ssh
	quotepath = false

[user]
  email = 2352112+anxolin@users.noreply.github.com
	name = Anxo

[init]
  defaultBranch = main

[push]
  default = simple

[pull]
  rebase = true

[rebase]
  autosquash = true
  autostash = true

[fetch]
  prune = true

[rerere]
  enabled = true

[column]
  ui = auto

[branch]
  sort = -committerdate

[log]
  date = relative

[format]
  pretty = format:%C(yellow)%h %Cblue%>(12)%ad %Cgreen%<(7)%aN%Cred%d %Creset%s

[credential]
  helper = cache --timeout=86400

[include]
  path = ~/.gitconfig.local

[merge]
  tool = vscode
[mergetool "vscode"]
  cmd = code --wait $MERGED

[diff]
  tool = difftastic
  algorithm = histogram
  colorMoved = zebra
[difftool "vscode"]
  cmd = code --wait --diff $LOCAL $REMOTE
[difftool]
  prompt = false
[difftool "difftastic"]
  cmd = difft "$LOCAL" "$REMOTE"
[pager]
  difftool = "less -RFX"

[alias]
  d = difftool -t difftastic
  difftastic = difftool -t difftastic
  diffvs = difftool -t vscode

[credential "https://github.com"]
	helper = 
	helper = !/opt/homebrew/bin/gh auth git-credential
[credential "https://gist.github.com"]
	helper = 
	helper = !/opt/homebrew/bin/gh auth git-credential
