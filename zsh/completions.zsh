###############################################################################
#  Completions generated by the tools themselves                             #
###############################################################################
# Brew drops a _<tool> file in site-functions for everything it installs; tools
# installed any other way (foundry, solana, rustup, uv, deno) ship nothing. Most
# of them can print their own completion script, so cache that output and
# regenerate only when the binary is newer than the cache — a stat per tool at
# startup, and a real run only after an upgrade.
#
# Two phases, because the cache dir has to be on fpath before Oh My Zsh runs
# compinit, while these tools only reach PATH afterwards (~/.zsh/*.zsh):
#   zsh-completions-init      sourced before oh-my-zsh.sh
#   zsh-completions-refresh   called after the machine-local config
#
# Adding a tool is one line below: the command, then the arguments that make it
# print a zsh completion script.

export ZSH_COMPLETIONS_CACHE="${XDG_CACHE_HOME:-$HOME/.cache}/zsh/completions"

typeset -ga ZSH_COMPLETION_TOOLS=(
  'forge completions zsh'
  'cast completions zsh'
  'anvil completions zsh'
  'solana completion --shell zsh'
  'rustup completions zsh'
  'uv generate-shell-completion zsh'
  'deno completions zsh'
)

zsh-completions-init() {
  [[ -d $ZSH_COMPLETIONS_CACHE ]] || mkdir -p $ZSH_COMPLETIONS_CACHE
  fpath=($ZSH_COMPLETIONS_CACHE $fpath)
}

zsh-completions-refresh() {
  local spec cmd bin out refreshed=0
  local -a parts
  for spec in $ZSH_COMPLETION_TOOLS; do
    parts=(${=spec})
    cmd=$parts[1]
    bin=${commands[$cmd]}
    [[ -n $bin ]] || continue
    out=$ZSH_COMPLETIONS_CACHE/_$cmd
    # Up to date: cache exists and is newer than the binary it describes.
    [[ -s $out && $out -nt $bin ]] && continue
    if $bin ${parts[2,-1]} >| $out.new 2>/dev/null && [[ -s $out.new ]]; then
      mv -f $out.new $out
      refreshed=1
    else
      rm -f $out.new
    fi
  done

  # New or changed completions are invisible until compinit indexes them.
  if (( refreshed )); then
    local dump="${ZSH_COMPDUMP:-${ZDOTDIR:-$HOME}/.zcompdump}"
    rm -f $dump
    autoload -U compinit && compinit -i -d $dump
  fi

  # Claim the commands back: carapace's bridge (sourced earlier) binds every
  # command it recognises to _carapace_completer, which only reaches the same
  # completion through a subprocess. These run last, so they win.
  (( $+functions[compdef] )) || return 0
  for out in $ZSH_COMPLETIONS_CACHE/_*(N); do
    compdef ${out:t} ${${out:t}#_}
  done
}

# Drop one cached completion, or all of them, and rebuild on the next shell.
zsh-completions-clean() {
  if (( $# )); then
    rm -f $ZSH_COMPLETIONS_CACHE/_$1
  else
    rm -f $ZSH_COMPLETIONS_CACHE/_*(N)
  fi
  rm -f "${ZSH_COMPDUMP:-${ZDOTDIR:-$HOME}/.zcompdump}"
}
